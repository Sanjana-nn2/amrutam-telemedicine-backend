# ==========================================
# Amrutam Telemedicine Backend Environment Config
# ==========================================

# Application
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# PostgreSQL Docker Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_local_password
POSTGRES_DB=amrutam_telemedicine

# PostgreSQL Database (Prisma)
# Docker exposes PostgreSQL on host port 5433.
DATABASE_URL="postgresql://postgres:change_me_local_password@localhost:5433/amrutam_telemedicine?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Authentication
# Replace these example values before production deployment.
JWT_ACCESS_SECRET="change_me_access_secret_key_minimum_32_characters_long"
JWT_REFRESH_SECRET="change_me_refresh_secret_key_minimum_32_characters_long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AES-256-GCM Encryption Key
# Must be exactly 64 hexadecimal characters (32 bytes).
# Replace this example key before production deployment.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL="info"