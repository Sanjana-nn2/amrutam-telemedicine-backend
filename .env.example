# ==========================================
# Amrutam Telemedicine Backend Environment Config
# ==========================================

# Application
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# PostgreSQL Database (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amrutam_telemedicine?schema=public"

# Redis Cache & Lock Provider (Optional for basic local dev, fallback to memory/noop)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_ACCESS_SECRET="amrutam_super_secure_access_secret_key_minimum_32_characters_long"
JWT_REFRESH_SECRET="amrutam_super_secure_refresh_secret_key_minimum_32_characters_long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AES-256-GCM Encryption Key for PHI/PII (Must be 32 bytes hex encoded = 64 hex characters)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL="info"
